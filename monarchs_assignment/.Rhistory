knitr::opts_chunk$set(echo = TRUE)
knitr::opts_chunk$set(root.dir = ".")
#loading packages
library(pacman)
pacman::p_load(ggplot2, tidyverse, tibble)
#creating a tibble
tib <- tibble(
monarch_name = c("Gorm the Old","Harald I", "Sweyn I", "Harald II", "Canute II", "Hardecanute", "Magnus I Olafsson"),
monarch_id = c("gorm_the_old","harald_first","sweyn_first","harald_second","canute_second","hardecanute","magnus_first_olafsson"),
date_birth = c("","","","","","",""),
start_reign = c("","958","987","1014","1019","1028","1042"),
end_reign = c("958","985","1014","1018","1035","1042","1047"))
#inspecting the data
head(tib)
#saving original dataset created as Tibble
write.csv(tib,file = "../data/monarchy_data.csv",row.names=TRUE)
#saving original dataset created as Tibble
df <- write.csv(tib,file = "../data/monarchy_data.csv",row.names=TRUE)
#saving original dataset created as Tibble
df <- write.csv(tib,file = "../data/monarchy_data.csv",row.names=TRUE)
#saving original dataset created as Tibble
write.csv(tib,file = "../data/monarchy_data.csv",row.names=TRUE)
#saving original dataset created as Tibble
write.csv(tib,file = "../data/monarchy_data.csv",row.names=TRUE)
df <- read.csv("../data/monarchy_data.csv")
#creating a tibble
tib <- tibble(
monarch_name = c("Gorm the Old","Harald I", "Sweyn I", "Harald II", "Canute II", "Hardecanute", "Magnus I Olafsson"),
date_birth = c("","","","","","",""),
start_reign = c("","958","987","1014","1019","1028","1042"),
end_reign = c("958","985","1014","1018","1035","1042","1047"))
#inspecting the data
head(tib)
#saving original dataset created as Tibble
write.csv(tib,file = "../data/monarchy_data.csv",row.names=TRUE)
df <- read.csv("../data/monarchy_data.csv")
#adding monarch_id for reproducibility
mutate(df,monarch_id)
#adding monarch_id for reproducibility
df <- df %>%
mutate(
monarch_id=monarch_name %>%
str_to_lower() %>%
str_replace_all("\\s+", "_")
)
#adding monarch_id for reproducibility
df <- df %>%
mutate(
monarch_id=monarch_name %>%
str_to_lower() %>%
str_replace_all("\\s+", "_")
)
